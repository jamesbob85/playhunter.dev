---
import type { Facts } from '../lib/facts';
import { playImg } from '../lib/facts';

interface Props {
  facts: Facts;
  hook: string;
  accent: string;
  wide?: boolean;
}
const { facts, hook, accent, wide = false } = Astro.props;
---

<a href={`/${facts.slug}/`} class:list={['card', { wide }]} style={`--card-accent:${accent}`}>
  <div class="art">
    {facts.headerImage
      ? <img src={playImg(facts.headerImage, wide ? 1200 : 640)} alt={facts.title} loading="lazy" decoding="async" />
      : <img src={playImg(facts.icon, 512)} alt={facts.title} loading="lazy" decoding="async" />}
    <span class="price mono">{facts.priceText}</span>
  </div>
  <div class="meta">
    <h3>{facts.title}</h3>
    <p class="dim hook">{hook}</p>
    <p class="mono sub">{facts.score} ★ · {facts.installs} · {facts.genre}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
    width: 17rem;
  }
  .card.wide { width: min(26rem, 78vw); }
  .art {
    position: relative;
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--hair);
    aspect-ratio: 1.91;
    background: var(--bg-raise);
  }
  .art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms cubic-bezier(0.2, 0.6, 0.2, 1);
  }
  .card:hover .art img { transform: scale(1.035); }
  .card:hover h3 { color: var(--card-accent); }
  .price {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    background: rgba(10, 10, 12, 0.82);
    backdrop-filter: blur(6px);
    color: var(--fg);
    font-weight: 700;
    font-size: 0.75rem;
    padding: 0.3rem 0.55rem;
    border-radius: 3px;
    border: 1px solid var(--hair-strong);
  }
  .meta { padding-top: 0.8rem; }
  h3 { font-size: 1.05rem; transition: color 120ms ease; }
  .hook {
    font-size: 0.875rem;
    line-height: 1.45;
    margin-top: 0.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sub { margin-top: 0.45rem; font-size: 0.6875rem; color: var(--fg-faint); }
</style>
